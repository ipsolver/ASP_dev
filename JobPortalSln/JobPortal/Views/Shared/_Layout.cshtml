<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>JobPortal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

</head>
<body>

    <header class="bg-primary text-white py-3">
        <div class="container text-center">
            <h1>JobPortal</h1>
            <p>For searching yourself</p>
        </div>

        <div class="container d-flex justify-content-between align-items-center px-3">
            <div>
                <a asp-controller="Users" asp-action="Index" class="btn btn-light me-2">Users</a>
                <a asp-controller="Applications" asp-action="Index" class="btn btn-light">Applications</a>
            </div>

            <div>
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-light">Кабінет</a>
                        <a class="nav-link" asp-controller="Account" asp-action="Notifications">Сповіщення:</a>
                    <a class="nav-link" href="/Account/Notifications">
                        Notifications
                        @await Html.PartialAsync("_NotificationCounter")
                    </a>

                    <br />
                    <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                        <button class="btn btn-danger">Вийти</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Увійти</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light">Реєстрація</a>
                }
            </div>
        </div>
    </header>


    <main class="container my-3">
        @RenderBody()
    </main>

    <div id="notificationArea" class="position-fixed top-0 end-0 p-3" style="z-index: 1100;"></div>


    <footer class="bg-dark text-white text-center py-3 mt-2">
        <p>&copy; @DateTime.Now.Year JobPortal</p>
    </footer>

    


    @RenderSection("Scripts", required: false)
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>


    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        connection.on("ReceiveNotification", (message) => {
            console.log("Нова вакансія " + message);

            const counterSpan = document.getElementById("notificationCount");
            if (counterSpan) {
                let current = parseInt(counterSpan.textContent) || 0;
                counterSpan.textContent = current + 1;
            }

            const notifDiv = document.getElementById("notificationArea");
            if (notifDiv) {
                notifDiv.innerHTML = `<div class="alert alert-info alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
            }
        });

        connection.start().catch(err => console.error(err.toString()));
    </script>





</body>
</html>
