
@{
    ViewData["Title"] = "Your Profile";
}
@model JobPortal.Models.ViewModels.ProfileViewModel

<h2>Особистий кабінет</h2>

@if (!string.IsNullOrEmpty(ViewBag.Message))
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

<form asp-action="Profile" method="post">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <input type="hidden" asp-for="User.UsersID" />

    <div class="form-group">
        <label asp-for="User.Name"></label>
        <input asp-for="User.Name" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="User.LastName"></label>
        <input asp-for="User.LastName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="User.PhoneNumber"></label>
        <input asp-for="User.PhoneNumber" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="User.City"></label>
        <input asp-for="User.City" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="User.Description"></label>
        <textarea asp-for="User.Description" class="form-control"></textarea>
    </div>



    <h4>Категорії, які вас цікавлять:</h4>
    <div class="form-group">
        @foreach (var category in Model.AllCategories)
        {
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="SelectedCategoryIDs"
                       value="@category.CategoryID"
                @(Model.SelectedCategoryIDs.Contains(category.CategoryID) ? "checked" : "") />
                <label class="form-check-label">@category.CategoryName</label>
            </div>
        }
    </div>



    <button type="submit" class="btn btn-success">Зберегти зміни</button>
</form>
