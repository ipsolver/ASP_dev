@model JobPortal.Models.Application

@{
    ViewData["Title"] = "Delete Application";
}

<h2>Delete Application</h2>

<h4>Are you sure you want to delete this application?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-2">Job</dt>
    <dd class="col-sm-10">@Model.Job?.Title</dd>

    <dt class="col-sm-2">Candidate</dt>
    <dd class="col-sm-10">@Model.Candidate?.Login</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="ApplicationID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
