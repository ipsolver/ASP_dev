@model IEnumerable<JobPortal.Models.Application>

@{
    ViewData["Title"] = "Applications";
}

<h2>Applications</h2>

@if (User.IsInRole("Employee"))
{
    <p><a asp-action="Create" class="btn btn-primary">Create New Application</a></p>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Job Title</th>
            <th>Candidate</th>
            <th>Application Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model)
        {
            <tr>
                <td>@app.Job?.Title</td>
                <td>@app.Candidate?.Login</td>
                <td>@app.ApplicationDate.ToShortDateString()</td>
                <td>@app.Status</td>
                <td>
                    @if (User.IsInRole("Employee") || User.IsInRole("Manager"))
                    {
                        <a asp-action="Edit" asp-route-id="@app.ApplicationID">Edit</a>
                    }
                    @if (User.IsInRole("Employee"))
                    {
                        <a asp-action="Delete" asp-route-id="@app.ApplicationID">Delete</a>
                    }
                    <a asp-action="Details" asp-route-id="@app.ApplicationID">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
