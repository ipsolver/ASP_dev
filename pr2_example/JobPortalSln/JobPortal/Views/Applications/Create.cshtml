@model JobPortal.Models.Application

@{
    ViewData["Title"] = "Create Application";
}

<h2>Create Application</h2>

<form asp-action="Create">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="JobID"></label>
        <select asp-for="JobID" asp-items="ViewBag.Jobs" class="form-control"></select>
        <span asp-validation-for="JobID" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CandidateID"></label>
        <select asp-for="CandidateID" asp-items="ViewBag.Users" class="form-control"></select>
        <span asp-validation-for="CandidateID" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CoverLetter"></label>
        <textarea asp-for="CoverLetter" class="form-control"></textarea>
        <span asp-validation-for="CoverLetter" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Resume"></label>
        <input asp-for="Resume" class="form-control" />
    </div>


    <button type="submit" class="btn btn-success">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
