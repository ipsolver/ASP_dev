@model JobPortal.Models.Users

<div class="card mb-2 shadow-sm">
    <div class="card-body">
        <h3 class="card-title">@Model.Name @Model.LastName</h3>
        <h4 class="card-subtitle text-muted">@Model.PhoneNumber</h4>
        <h5 class="card-subtitle text-muted">@Model.City</h5>
        <p class="card-text mt-2">@Model.Description</p>
    </div>
</div>